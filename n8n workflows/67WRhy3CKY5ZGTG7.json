      {
        "parameters": {
          "jsCode": "const headers = $input.first().json.headers || {};\nconst token = headers['x-complianceops-token'];\nconst expected = $env.COMPLIANCEOPS_INGEST_TOKEN || 'change-me';\nif (!token || token !== expected) throw new Error('Unauthorized');\nconst body = $input.first().json.body || {};\nif (!body.runId || !body.framework || !body.evidence) throw new Error('Missing required fields');\nif (!Array.isArray(body.evidence)) throw new Error('evidence must be array');\nreturn [{ json: body }];"
        },
        "id": "ac1703d7-f0cb-44a3-8da0-8b94e1840712",
        "name": "Authenticate",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          -1280,
          80
        ]
      },
      {
        "parameters": {
          "jsCode": "const body = $input.first().json;\nfunction redact(obj) {\n  if (!obj) return obj;\n  const clone = JSON.parse(JSON.stringify(obj));\n  const sens = /token|password|secret|key|authorization|cookie|credential/i;\n  const walk = (o) => {\n    if (!o || typeof o !== 'object') return;\n    for (const k of Object.keys(o)) {\n      if (typeof o[k] === 'string' && sens.test(k)) o[k] = '[REDACTED]';\n      else if (o[k] && typeof o[k] === 'object') walk(o[k]);\n    }\n  };\n  walk(clone);\n  return clone;\n}\nconst events = [];\nfor (const e of body.evidence) {\n  if (!e.controlId || !e.resourceId) continue;\n  const findingKey = `${e.controlId}::${e.resourceId}::${body.framework}`;\n  events.push({\n    json: {\n      runId: body.runId, source: body.source || 'unknown', framework: body.framework,\n      timestamp: body.timestamp, findingKey, controlId: e.controlId, resourceId: e.resourceId,\n      resourceName: e.resourceName || e.resourceId, service: e.service || 'unknown',\n      passed: e.passed === true, severity: e.severity || 'medium',\n      evidencePath: e.evidencePath || null, rawData: redact(e.rawData || e)\n    }\n  });\n}\nif (events.length === 0) throw new Error('No valid evidence events');\nreturn events;"
        },
