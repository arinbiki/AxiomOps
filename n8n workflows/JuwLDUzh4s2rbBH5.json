      {
        "parameters": {
          "jsCode": "const body = $input.first().json.body || $input.first().json;\nif (!body.assets || !Array.isArray(body.assets)) throw new Error('assets array required');\nif (!body.controls || !Array.isArray(body.controls)) throw new Error('controls array required');\n\nconst assets = body.assets.map(a => {\n  if (!a.assetId || !a.resourceId || !a.service) throw new Error('asset requires assetId, resourceId, service');\n  return { json: { ...a, tags: a.tags || [] } };\n});\nconst controls = body.controls.map(c => {\n  if (!c.controlId || !c.framework) throw new Error('control requires controlId, framework');\n  return { json: c };\n});\n\nreturn [\n  { json: { type: 'assets', items: assets, count: assets.length } },\n  { json: { type: 'controls', items: controls, count: controls.length } }\n];"
        },
