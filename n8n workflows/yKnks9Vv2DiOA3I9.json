      {
        "parameters": {
          "jsCode": "const finding = $input.all().find(i => i.json.finding_key)?.json || {};\nconst asset = $input.all().find(i => i.json.asset_id)?.json || null;\nconst control = $input.all().find(i => i.json.control_id && i.json.framework)?.json || null;\n\nlet ownerEmail = null, ownerStatus = 'unresolved', team = null, escalationEmail = null, missingOwner = false;\n\nif (asset?.owner_email) {\n  ownerEmail = asset.owner_email; team = asset.team || null; escalationEmail = asset.escalation_email || null;\n  ownerStatus = 'resolved_asset_owner';\n} else if (control?.default_owner_email) {\n  ownerEmail = control.default_owner_email; ownerStatus = 'resolved_control_default';\n} else {\n  ownerEmail = $env.COMPLIANCE_ADMIN_EMAIL || 'compliance-admin@example.com';\n  escalationEmail = $env.COMPLIANCE_ESCALATION_EMAIL || 'ciso@example.com';\n  ownerStatus = 'missing_owner_fallback'; missingOwner = true;\n}\n\nreturn [{\n  json: {\n    findingKey: finding.finding_key, assetId: asset?.asset_id || null,\n    ownerEmail, ownerStatus, team, escalationEmail, missingOwner\n  }\n}];"
        },
