          "query": "INSERT INTO findings (finding_key, control_id, framework, resource_id, service, status, severity, occurrence_count, first_seen, last_seen, latest_evidence_run_id, latest_evidence_passed, updated_at)\nVALUES ($1,$2,$3,$4,$5,'open',$6,1,now(),now(),$7,false,now())\nON CONFLICT (finding_key) DO UPDATE SET\n  status = CASE WHEN findings.status='closed' THEN 'reopened' ELSE findings.status END,\n  severity = EXCLUDED.severity, last_seen = EXCLUDED.last_seen,\n  occurrence_count = CASE WHEN findings.status='closed' THEN 1 ELSE findings.occurrence_count + 1 END,\n  latest_evidence_run_id = EXCLUDED.latest_evidence_run_id, latest_evidence_passed = false,\n  closed_at = NULL, closure_reason = NULL, updated_at = now() RETURNING *;",
