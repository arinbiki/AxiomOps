# AxiomOps Test Configuration
# Copy this to .env and fill in your real values

# n8n
N8N_URL=http://localhost:5678
COMPLIANCEOPS_INGEST_TOKEN=change-me

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me

# Jira (optional, for ticket verification)
JIRA_URL=https://your-domain.atlassian.net
JIRA_PROJECT_KEY=COMP

# Alert webhook (Slack/Discord/Teams)
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
