      "typeVersion": 2.1,
      "position": [
        1450,
        400
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT occurrence_count FROM findings WHERE finding_key = 'CC6.6::arn:aws:s3:::race-bucket::SOC2';",
        "options": {
          "nodeVersion": "2.1"
        }
      }
    },
    {
      "id": "42100439-a7ee-46f9-8d71-35dbffdeb179",
      "name": "Race OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1650,
        400
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "a78a5779-a0ba-4231-b3c3-e45c16e0ff0e",
              "leftValue": "={{ parseInt($json.occurrence_count) }}",
              "rightValue": 1,
              "operator": {
                "type": "number",
                "operation": "eq"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
