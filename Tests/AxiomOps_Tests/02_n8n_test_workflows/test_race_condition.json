      "parameters": {
        "jsCode": "const payload = {\n  source: 'ComplianceGuardPro', runId: 'RUN-RACE-001', framework: 'SOC2',\n  timestamp: new Date().toISOString(),\n  evidence: [{ controlId: 'CC6.6', resourceId: 'arn:aws:s3:::race-bucket', resourceName: 'race-bucket',\n    service: 'aws', passed: false, severity: 'high', evidencePath: 'test/race.json', rawData: { test: true } }]\n};\n// Return 5 identical items to simulate parallel requests\nreturn Array(5).fill(0).map(() => ({ json: { ...payload } }));"
      }
    },
    {
      "id": "c65ebfd0-0cea-40f1-97eb-11a0408f5cfc",
      "name": "Split Race",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        650,
        400
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "b0508a27-c328-44d8-ac18-780b52224b98",
      "name": "Send Race",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        850,
        400
      ],
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5678/webhook/complianceops-finding-ingestion",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-COMPLIANCEOPS-TOKEN",
              "value": "change-me"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "74aa70d7-7209-4d76-a727-24023e1cd222",
      "name": "Race Done",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1050,
        400
      ],
      "parameters": {}
