      {
        "parameters": {
          "jsCode": "const finding = $input.all().find(i => i.json.finding_key)?.json || {};\nconst evidence = $input.all().filter(i => i.json.passed !== undefined).map(i => i.json);\nconst required = parseInt($env.REQUIRED_CONSECUTIVE_PASSES || '1', 10);\nconst passCount = evidence.slice(0, required).filter(e => e.passed === true).length;\nconst shouldClose = passCount >= required;\nreturn [{\n  json: {\n    findingKey: finding.finding_key, shouldClose, passCount, requiredPasses: required,\n    closureReason: shouldClose ? 'consecutive_evidence_passed' : 'insufficient_passes'\n  }\n}];"
